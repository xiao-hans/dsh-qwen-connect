{
  "name": "@xiao-hans/dsh-qwen-connect",
  "displayName": "DSH Qwen Work Connect",
  "version": "0.1.4",
  "type": "module",
  "description": "DSH 插件：复用 QwenWorkCN（千问办公）桌面 App 登录态，零配置接入 DSH",
  "main": "lib/index.js",
  "files": [
    "INSTALL-新电脑.md",
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "docs/",
    "lib/",
    "package.json",
    "research/",
    "tools/",
    "一键卸载.cmd",
    "一键安装.cmd",
    "安装说明.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./credentials": "./lib/credentials.js",
    "./rest": "./lib/rest.js",
    "./errors": "./lib/errors.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiao-hans/dsh-qwen-connect.git"
  },
  "bugs": {
    "url": "https://github.com/xiao-hans/dsh-qwen-connect/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "qwenwork",
    "qwen",
    "llm-provider",
    "mcp",
    "openai-compatible"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2 || ^5.0.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.2-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2 || ^4.0.0-0",
    "@earendil-works/pi-ai": ">=0.84.4 <0.86.0 || >=1.0.0-0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "private": true
}
